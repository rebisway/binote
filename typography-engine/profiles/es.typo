# Spanish typography: angle quotation marks without spaces (RAE), typographic apostrophe and ellipsis.
# The inverted marks ¿ ¡ are added at the start of the sentence (a question inside a sentence: type the ¿ yourself, it is kept).

[profile]
name = Spanish

[quotes]
open = «
close = »
alt_open = “
alt_close = ”
open_after = space tab ( [ – — « “ ¿ ¡
open_after_typed = space tab ( [ – —

[apostrophe]
char = ’

[ellipsis]
char = …

[inverted]
# The sign which ends a sentence = the mark put at the start of it
? = ¿
! = ¡

[context]
# The signs which may follow ? or ! when they close something
closers = ) " » * _ ]
