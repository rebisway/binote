# Czech typography: „ “ quotation marks, ellipsis, no line break after a one-letter word.

[profile]
name = Czech

[quotes]
open = „
close = “
alt_open = “
alt_close = ”
open_after = space tab ( [ – — „
open_after_typed = space tab ( [ – —

[apostrophe]
char = ’

[ellipsis]
char = …

[orphans]
words = a i k o s u v z
