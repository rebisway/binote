# English typography: curly quotation marks, typographic apostrophe and ellipsis. No space before the signs.

[profile]
name = English

[quotes]
open = “
close = ”
alt_open = “
alt_close = ”
open_after = space tab ( [ – — “ ‘
open_after_typed = space tab ( [ – —

[apostrophe]
char = ’

[ellipsis]
char = …
